{
  "opencollection": "1.0.0",
  "info": {
    "name": "Juniper Networks Juniper Apstra Intent-Based Networking Alarms System API",
    "version": "4.2"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "AuthToken",
      "value": "{{AuthToken}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "System",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Juniper Networks Get system information",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{apstra_server}/api/v1/system/information"
          },
          "docs": "Returns system information including hostname, model, Junos version, serial number, and uptime."
        },
        {
          "info": {
            "name": "Juniper Networks List system alarms",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{apstra_server}/api/v1/system/alarms"
          },
          "docs": "Returns active system alarms on the vSRX."
        }
      ]
    }
  ],
  "bundled": true
}