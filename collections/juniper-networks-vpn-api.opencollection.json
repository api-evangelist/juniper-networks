{
  "opencollection": "1.0.0",
  "info": {
    "name": "Juniper Networks Juniper Apstra Intent-Based Networking Alarms VPN API",
    "version": "4.2"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "AuthToken",
      "value": "{{AuthToken}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "VPN",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Juniper Networks List IPsec VPN tunnels",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{apstra_server}/api/v1/security/ipsec/vpn"
          },
          "docs": "Returns all IPsec VPN tunnel configurations, including IKE gateway associations, encryption settings, and tunnel status."
        }
      ]
    }
  ],
  "bundled": true
}