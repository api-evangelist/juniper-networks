          "name": "Juniper Networks List blueprint anomalies",
          "request": {
            "name": "Juniper Networks List blueprint anomalies",
            "description": {
              "content": "Returns anomalies detected in a blueprint. Anomalies represent deviations between the intended state defined in the blueprint and the actual state observed on network devices. Includes configuration drift, cabling issues, and BGP session problems.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "blueprints",
                ":blueprint_id",
                "anomalies"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<uuid>",
                  "key": "blueprint_id",
                  "description": "(Required) Blueprint unique identifier."
                },
                {
                  "description": "Hostname or IP address of the Apstra server.",
                  "type": "any",
                  "value": "{{apstra_server}}",
                  "key": "apstra_server"
                }
              ]
            },
